    },
    "Removes filler words, fixes punctuation and sets paragraphs. Optional.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Füllwörter, korrigiert die Zeichensetzung und setzt Absätze. Optional."
          }
        }
      }
    },
    "Results and their recordings are kept on this device for %@, then deleted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergebnisse und ihre Aufnahmen bleiben %@ auf diesem Gerät und werden dann gelöscht."
          }
        }
      }
    },
    "Results are kept for %@.": {
      "localizations": {

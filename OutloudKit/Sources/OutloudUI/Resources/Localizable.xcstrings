        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnen"
          }
        }
      }
    },
    "Outloud keeps no results and no recordings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Outloud behält keine Ergebnisse und keine Aufnahmen."
          }
        }
      }
    },
    "Outloud keeps no results. You can change this in the settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Outloud behält keine Ergebnisse. Das kannst du in den Einstellungen ändern."
          }
        }
      }
    },
    "Outloud may not use the microphone. Allow it in System Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Outloud darf das Mikrofon nicht verwenden. Erlaube es in den Einstellungen."
          }
        }
      }
    },
    "Outloud transcribes and cleans up on this device. It needs its models once; after that, nothing you say leaves the device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Outloud transkribiert und bereinigt auf diesem Gerät. Die Modelle werden einmal geladen; danach verlässt nichts, was du sagst, das Gerät."
          }
        }
      }
    },
    "Play": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abspielen"
          }
        }
      }
    },

          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Speicherplatz: %@ benötigt, %@ frei."
          }
        }
      }
    },
    "The download failed (HTTP %lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download ist fehlgeschlagen (HTTP %lld)."

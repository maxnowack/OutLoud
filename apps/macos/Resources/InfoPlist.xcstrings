    "NSAudioCaptureUsageDescription" : {
      "comment" : "Privacy - Audio Capture Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud hört, ob Musik oder ein Video beim Diktieren pausiert hat, damit danach nur weiterspielt, was es pausiert hat. Dabei wird nichts aufgenommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud listens whether music or a video paused while you dictate, so that it plays on afterwards only what it paused. Nothing is recorded."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud nimmt deine Stimme auf, solange du das Kürzel hältst, um sie auf diesem Mac in Text umzuwandeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud records your voice while you hold the shortcut, to turn it into text on this Mac."
          }
        }
      }
    }
  },
  "version" : "1.0"

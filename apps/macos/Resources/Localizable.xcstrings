{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is used by another app. Choose another shortcut in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird von einer anderen App verwendet. Wähle in den Einstellungen ein anderes Kürzel."
          }
        }
      }
    },
    "%@ needs Accessibility access. Until it is allowed, hold %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ braucht Zugriff auf die Bedienungshilfen. Bis er erlaubt ist, halte %@."
          }
        }
      }
    },
    "%@ – good enough from %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ – gut genug ab %2$@"
          }
        }
      }
    },
    "%@ – good enough to use" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – gut genug zum Benutzen"
          }
        }
      }
    },
    "%@, from %lld samples" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, aus %2$lld Beispielen"
          }
        }
      }
    },
    "%lld, %lld of them silent – %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld, davon %2$lld ohne Ton – %3$@"
          }
        }
      }
    },
    "Accessibility access" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff für Bedienungshilfen"
          }
        }
      }
    },
    "Accuracy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genauigkeit"
          }
        }
      }
    },
    "Acknowledgements" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danksagungen"
          }
        }
      }
    },
    "After %lld more samples" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach %lld weiteren Beispielen"
          }
        }
      }
    },
    "Allow Accessibility…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedienungshilfen erlauben …"

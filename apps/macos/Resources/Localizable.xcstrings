    "Allowed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt"
          }
        }
      }
    },
    "Allow…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben …"
          }
        }
      }
    },
    "Always, without sound" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer, ohne Ton"
          }
        }
      }
    },
    "Camera access" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamerazugriff"
          }
        }
      }
    },
    "Check for Updates…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Updates suchen …"
          }
        }
      }
    },
    "Clean up the transcript" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkript bereinigen"
          }
        }
      }
    },
    "Cleanup" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereinigung"
          }
        }
      }
    },
    "Click Start, then mouth the sentence without sound." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf „Start“ und forme dann den Satz ohne Ton."
          }
        }
      }
    },
    "Close" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen"
          }
        }
      }
    },
    "Copied — press ⌘V where you want the text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert – drücke ⌘V dort, wo der Text hin soll."
          }
        }
      }
    },
    "Copied — press ⌘V." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert – drücke ⌘V."
          }
        }
      }
    },
    "Copied — press ⌘V. Allow Accessibility to paste automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert – drücke ⌘V. Erlaube Bedienungshilfen, um automatisch einzufügen."
          }
        }
      }
    },
    "Delete All" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle löschen"
          }
        }
      }
    },
    "Delete all results?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Ergebnisse löschen?"
          }
        }
      }
    },
    "Delete All Results…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Ergebnisse löschen …"
          }
        }
      }
    },
    "Delete all samples?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Beispiele löschen?"
          }
        }
      }
    },
    "Delete Samples…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beispiele löschen …"
          }
        }
      }
    },
    "Dictating" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktieren"
          }
        }
      }
    },
    "Dictations wait to be pasted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktate warten aufs Einfügen"
          }
        }
      }
    },
    "Done" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertig"
          }
        }
      }
    },
    "Each result keeps the transcript, the recording and the cleaned version. A shorter period also applies to results already kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu jedem Ergebnis gehören das Transkript, die Aufnahme und die bereinigte Fassung. Ein kürzerer Zeitraum gilt auch für bereits behaltene Ergebnisse."
          }
        }
      }
    },
    "English" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Englisch"
          }
        }
      }
    },
    "Experimental" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimentell"
          }
        }
      }
    },
    "General" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allgemein"
          }
        }
      }
    },
    "German" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deutsch"
          }
        }
      }
    },
    "History" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlauf"
          }
        }
      }
    },
    "History…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlauf …"
          }
        }
      }
    },
    "Hold %@ anywhere, speak, and release. Outloud asks for the microphone once. To paste into the active text field automatically, it also needs Accessibility access; without it, the result is copied to the clipboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte überall %@ gedrückt, sprich und lass los. Outloud fragt einmal nach dem Mikrofon. Um automatisch ins aktive Textfeld einzufügen, braucht es außerdem Zugriff für Bedienungshilfen; ohne ihn landet das Ergebnis in der Zwischenablage."
          }
        }
      }
    },
    "Hold %@ to dictate, release it to paste." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte %@ zum Diktieren, lass los zum Einfügen."
          }
        }
      }
    },
    "Hold the shortcut while you speak; Outloud transcribes when you release it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte das Kürzel, während du sprichst; Outloud transkribiert, wenn du loslässt."
          }
        }
      }
    },
    "Language" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache"
          }
        }
      }
    },
    "Last learned" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuletzt gelernt"
          }
        }
      }
    },
    "Learn from my dictations" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus meinen Diktaten lernen"
          }
        }
      }
    },
    "Learn Now" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt lernen"
          }
        }
      }
    },
    "Learned: words misread fell from %@ to %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelernt: falsch gelesene Wörter sanken von %1$@ auf %2$@."
          }
        }
      }
    },
    "Learning failed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Lernen ist fehlgeschlagen."
          }
        }
      }
    },
    "Learning from your samples…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernt aus deinen Beispielen …"
          }
        }
      }
    },
    "Learning lip reading" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lernt Lippenlesen"
          }
        }
      }
    },
    "Lip Reading" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lippenlesen"
          }
        }
      }
    },
    "Lip reading is experimental: it still misreads many words, and reads you better the more it learns from your dictations. It needs its model on this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lippenlesen ist experimentell: Es liest noch viele Wörter falsch und liest dich besser, je mehr es aus deinen Diktaten lernt. Es braucht sein Modell auf diesem Mac."
          }
        }
      }
    },
    "Lip reading is ready" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lippenlesen ist bereit"
          }
        }
      }
    },
    "macOS asks you to allow Outloud in Login Items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS bittet dich, Outloud in den Anmeldeobjekten zu erlauben."
          }
        }
      }
    },
    "macOS did not allow it. Add Outloud in System Settings › General › Login Items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat es nicht erlaubt. Füge Outloud unter Systemeinstellungen › Allgemein › Anmeldeobjekte hinzu."
          }
        }
      }
    },
    "Measured on %lld held-back sentences" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemessen an %lld zurückgehaltenen Sätzen"
          }
        }
      }
    },
    "Model" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modell"
          }
        }
      }
    },
    "Models" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle"
          }
        }
      }
    },
    "More samples are needed to learn from." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Lernen braucht es mehr Beispiele."
          }
        }
      }
    },
    "Mouth the sentence without sound, looking at the camera. Then click Done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forme den Satz ohne Ton und schau dabei in die Kamera. Klicke dann auf „Fertig“."
          }
        }
      }
    },
    "Music or a video that plays pauses while you hold the shortcut and plays on afterwards. Outloud listens to the sound of other apps to tell, and needs Accessibility access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik oder ein Video, das gerade läuft, pausiert, solange du das Kürzel hältst, und spielt danach weiter. Outloud hört dafür in den Ton anderer Apps hinein und braucht Zugriff für Bedienungshilfen."
          }
        }
      }
    },
    "Music or a video that plays pauses while you hold the shortcut. To play it on afterwards, Outloud needs to hear whether it paused: allow it to record system audio." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik oder ein Video, das gerade läuft, pausiert, solange du das Kürzel hältst. Damit es danach weiterspielt, muss Outloud hören, ob es pausiert hat: Erlaube Outloud, Systemaudio aufzunehmen."
          }
        }
      }
    },
    "Next learning" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nächstes Lernen"
          }
        }
      }
    },
    "No face was seen. Sit in front of the camera and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es war kein Gesicht zu sehen. Setz dich vor die Kamera und versuche es noch einmal."
          }
        }
      }
    },
    "Not measured yet" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht gemessen"
          }
        }
      }
    },
    "Not yet" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht"
          }
        }
      }
    },
    "Nothing learned this time: %@ words misread, %@ before. The earlier state stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesmal nichts gelernt: %1$@ Wörter falsch gelesen, vorher %2$@. Der bisherige Stand bleibt."
          }
        }
      }
    },
    "Now" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt"
          }
        }
      }
    },
    "Off" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus"
          }
        }
      }
    },
    "Open at login" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Anmeldung öffnen"
          }
        }
      }
    },
    "Open Login Items…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmeldeobjekte öffnen …"
          }
        }
      }
    },
    "Open Outloud at login" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud bei der Anmeldung öffnen"
          }
        }
      }
    },
    "Outloud needs its models before you can dictate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud braucht seine Modelle, bevor du diktieren kannst."
          }
        }
      }
    },
    "Outloud now reads your lips in %@ well enough to dictate without sound. Choose a mode in Settings › Lip Reading." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud liest deine Lippen auf %@ jetzt gut genug, um ohne Ton zu diktieren. Wähle einen Modus unter Einstellungen › Lippenlesen."
          }
        }
      }
    },
    "Outloud waits in the menu bar, so the shortcut works right after you log in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud wartet in der Menüleiste, damit der Kurzbefehl direkt nach der Anmeldung funktioniert."
          }
        }
      }
    },
    "Paste into the active text field" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ins aktive Textfeld einfügen"
          }
        }
      }
    },
    "Pasted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingefügt"
          }
        }
      }
    },
    "Pastes into %@ when you are back in the text field." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird in %@ eingefügt, sobald du wieder im Textfeld bist."
          }
        }
      }
    },
    "Pause playback while dictating" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabe beim Diktieren pausieren"
          }
        }
      }
    },
    "Practise Silently…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Ton üben …"
          }
        }
      }
    },
    "Preparing sample %lld of %lld" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereitet Beispiel %lld von %lld vor"
          }
        }
      }
    },
    "Privacy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenschutz"
          }
        }
      }
    },
    "Push-to-talk shortcut" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-to-talk-Kürzel"
          }
        }
      }
    },
    "Quit Outloud" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud beenden"
          }
        }
      }
    },
    "Read the lips" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lippen lesen"
          }
        }
      }
    },
    "Recording system audio" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemaudio aufnehmen"
          }
        }
      }
    },
    "Removes filler words, fixes punctuation and sets paragraphs, without changing what you said." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt Füllwörter, korrigiert die Zeichensetzung und setzt Absätze, ohne zu ändern, was du gesagt hast."
          }
        }
      }
    },
    "Round %lld of %lld" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runde %lld von %lld"
          }
        }
      }
    },
    "Samples kept" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Beispiele"
          }
        }
      }
    },
    "Select a result" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Ergebnis"
          }
        }
      }
    },
    "Sentence %lld of %lld" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satz %1$lld von %2$lld"
          }
        }
      }
    },
    "Set Up Outloud" : {

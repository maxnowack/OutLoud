{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is used by another app. Choose another shortcut in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird von einer anderen App verwendet. Wähle in den Einstellungen ein anderes Kürzel."
          }
        }
      }
    },
    "%@ needs Accessibility access. Until it is allowed, hold %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ braucht Zugriff auf die Bedienungshilfen. Bis er erlaubt ist, halte %@."
          }
        }
      }
    },
    "Accessibility access" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff für Bedienungshilfen"
          }
        }
      }
    },
    "Acknowledgements" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danksagungen"
          }
        }
      }
    },
    "Allow Accessibility…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedienungshilfen erlauben …"
          }
        }
      }
    },
    "Allow…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben …"
          }
        }
      }
    },
    "Allowed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt"
          }
        }
      }
    },
    "Check for Updates…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Updates suchen …"
          }
        }
      }
    },
    "Clean up the transcript" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkript bereinigen"
          }
        }
      }
    },
    "Cleanup" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereinigung"
          }
        }
      }
    },
    "Copied — press ⌘V where you want the text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert – drücke ⌘V dort, wo der Text hin soll."
          }
        }
      }
    },
    "Copied — press ⌘V." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert – drücke ⌘V."
          }
        }
      }
    },
    "Copied — press ⌘V. Allow Accessibility to paste automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert – drücke ⌘V. Erlaube Bedienungshilfen, um automatisch einzufügen."
          }
        }
      }
    },
    "Delete All" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle löschen"
          }
        }
      }
    },
    "Delete all results?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Ergebnisse löschen?"
          }
        }
      }
    },
    "Delete All Results…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Ergebnisse löschen …"
          }
        }
      }
    },
    "Dictating" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktieren"
          }
        }
      }
    },
    "Each result keeps the transcript, the recording and the cleaned version. A shorter period also applies to results already kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu jedem Ergebnis gehören das Transkript, die Aufnahme und die bereinigte Fassung. Ein kürzerer Zeitraum gilt auch für bereits behaltene Ergebnisse."
          }
        }
      }
    },
    "General" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allgemein"
          }
        }
      }
    },
    "History" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlauf"
          }
        }
      }
    },
    "History…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlauf …"
          }
        }
      }
    },
    "Hold %@ anywhere, speak, and release. Outloud asks for the microphone once. To paste into the active text field automatically, it also needs Accessibility access; without it, the result is copied to the clipboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte überall %@ gedrückt, sprich und lass los. Outloud fragt einmal nach dem Mikrofon. Um automatisch ins aktive Textfeld einzufügen, braucht es außerdem Zugriff für Bedienungshilfen; ohne ihn landet das Ergebnis in der Zwischenablage."
          }
        }
      }
    },
    "Hold %@ to dictate, release it to paste." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte %@ zum Diktieren, lass los zum Einfügen."
          }
        }
      }
    },
    "Hold the shortcut while you speak; Outloud transcribes when you release it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte das Kürzel, während du sprichst; Outloud transkribiert, wenn du loslässt."
          }
        }
      }
    },
    "macOS asks you to allow Outloud in Login Items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS bittet dich, Outloud in den Anmeldeobjekten zu erlauben."
          }
        }
      }
    },
    "macOS did not allow it. Add Outloud in System Settings › General › Login Items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat es nicht erlaubt. Füge Outloud unter Systemeinstellungen › Allgemein › Anmeldeobjekte hinzu."
          }
        }
      }
    },
    "Model" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modell"
          }
        }
      }
    },
    "Models" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle"
          }
        }
      }
    },
    "Music or a video that plays pauses while you hold the shortcut and plays on afterwards. Outloud listens to the sound of other apps to tell, and needs Accessibility access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik oder ein Video, das gerade läuft, pausiert, solange du das Kürzel hältst, und spielt danach weiter. Outloud hört dafür in den Ton anderer Apps hinein und braucht Zugriff für Bedienungshilfen."
          }
        }
      }
    },
    "Music or a video that plays pauses while you hold the shortcut. To play it on afterwards, Outloud needs to hear whether it paused: allow it to record system audio." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik oder ein Video, das gerade läuft, pausiert, solange du das Kürzel hältst. Damit es danach weiterspielt, muss Outloud hören, ob es pausiert hat: Erlaube Outloud, Systemaudio aufzunehmen."
          }
        }
      }
    },
    "Open at login" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Anmeldung öffnen"
          }
        }
      }
    },
    "Open Login Items…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmeldeobjekte öffnen …"
          }
        }
      }
    },
    "Open Outloud at login" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud bei der Anmeldung öffnen"
          }
        }
      }
    },
    "Outloud needs its models before you can dictate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud braucht seine Modelle, bevor du diktieren kannst."
          }
        }
      }
    },
    "Outloud waits in the menu bar, so the shortcut works right after you log in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud wartet in der Menüleiste, damit der Kurzbefehl direkt nach der Anmeldung funktioniert."
          }
        }
      }
    },
    "Paste into the active text field" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ins aktive Textfeld einfügen"
          }
        }
      }
    },
    "Pasted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingefügt"
          }
        }
      }
    },
    "Pause playback while dictating" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabe beim Diktieren pausieren"
          }
        }
      }
    },
    "Privacy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenschutz"
          }
        }
      }
    },
    "Push-to-talk shortcut" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-to-talk-Kürzel"
          }
        }
      }
    },
    "Quit Outloud" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud beenden"
          }
        }
      }
    },
    "Recording system audio" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemaudio aufnehmen"
          }
        }
      }
    },
    "Removes filler words, fixes punctuation and sets paragraphs, without changing what you said." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt Füllwörter, korrigiert die Zeichensetzung und setzt Absätze, ohne zu ändern, was du gesagt hast."
          }
        }
      }
    },
    "Select a result" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ein Ergebnis"
          }
        }
      }
    },
    "Set Up Outloud" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud einrichten"
          }
        }
      }
    },
    "Set Up Outloud…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outloud einrichten …"
          }
        }
      }
    },
    "Settings…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen …"
          }
        }
      }
    },
    "Settings" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen"
          }
        }
      }
    },
    "Something is playing in the background" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Hintergrund läuft etwas"
          }
        }
      }
    },
    "This shortcut is used by another app. Choose another one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Kürzel wird von einer anderen App verwendet. Wähle ein anderes."
          }
        }
      }
    },
    "To paste automatically, Outloud needs Accessibility access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum automatischen Einfügen braucht Outloud Zugriff für Bedienungshilfen."
          }
        }
      }
    },
    "Transcription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkription"
          }
        }
      }
    },
    "Transcripts, recordings and cleaned versions are deleted from this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transkripte, Aufnahmen und bereinigte Fassungen werden von diesem Mac gelöscht."
          }
        }
      }
    },
    "Without it, or when no text field is focused, the result stays on the clipboard for pasting with ⌘V." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne ihn, oder wenn kein Textfeld ausgewählt ist, bleibt das Ergebnis zum Einfügen mit ⌘V in der Zwischenablage."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
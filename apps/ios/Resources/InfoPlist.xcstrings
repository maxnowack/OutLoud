    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Outloud nimmt deine Stimme auf, während du diktierst, um sie auf diesem iPhone in Text umzuwandeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outloud records your voice while you dictate, to turn it into text on this iPhone."
          }
        }
      }
    }
  },
  "version": "1.0"
}
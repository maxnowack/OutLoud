        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "A button at the bottom of the Lock Screen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Knopf unten auf dem Sperrbildschirm"
          }
        }
      }
    },
    "Acknowledgements": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danksagungen"
          }
        }
      }
    },
    "Action Button": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Action-Taste"
          }
        }
      }
    },
    "An icon next to your apps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Symbol neben deinen Apps"
          }
        }
      }
    },
    "Back Tap": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Rückseite tippen"
          }
        }
      }
    },
    "Can start by accident, e.g. when putting the iPhone down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann versehentlich auslösen, z. B. beim Ablegen des iPhones."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Choose Double Tap and pick the shortcut Dictate with Outloud.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Doppeltippen“ und den Kurzbefehl „Mit Outloud diktieren“."
          }
        }
      }
    },
    "Clean Up Text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text bereinigen"
          }
        }
      }
    },
    "Clean Up Text with Outloud": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text mit Outloud bereinigen"
          }
        }
      }
    },
    "Clean Up and Copy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigen und kopieren"
          }
        }
      }
    },
    "Clean up the transcript": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkript bereinigen"
          }
        }
      }
    },

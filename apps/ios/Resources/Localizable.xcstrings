{
  "sourceLanguage": "en",
  "strings": {
    "%lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "A button at the bottom of the Lock Screen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Knopf unten auf dem Sperrbildschirm"
          }
        }
      }
    },
    "Acknowledgements": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danksagungen"
          }
        }
      }
    },
    "Action Button": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Action-Taste"
          }
        }
      }
    },
    "An icon next to your apps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Symbol neben deinen Apps"
          }
        }
      }
    },
    "Back Tap": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Rückseite tippen"
          }
        }
      }
    },
    "Can start by accident, e.g. when putting the iPhone down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann versehentlich auslösen, z. B. beim Ablegen des iPhones."
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Choose Double Tap and pick the shortcut Dictate with Outloud.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Doppeltippen“ und den Kurzbefehl „Mit Outloud diktieren“."
          }
        }
      }
    },
    "Clean Up Text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text bereinigen"
          }
        }
      }
    },
    "Clean Up Text with Outloud": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text mit Outloud bereinigen"
          }
        }
      }
    },
    "Clean Up and Copy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigen und kopieren"
          }
        }
      }
    },
    "Clean up the transcript": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkript bereinigen"
          }
        }
      }
    },
    "Cleanup model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigungsmodell"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeren"
          }
        }
      }
    },
    "Control Center": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollzentrum"
          }
        }
      }
    },
    "Copied to the clipboard": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In die Zwischenablage kopiert"
          }
        }
      }
    },
    "Copied to the clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In die Zwischenablage kopiert."
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieren"
          }
        }
      }
    },
    "Delete All": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle löschen"
          }
        }
      }
    },
    "Delete All Results": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Ergebnisse löschen"
          }
        }
      }
    },
    "Delete all results?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Ergebnisse löschen?"
          }
        }
      }
    },
    "Dictate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren"
          }
        }
      }
    },
    "Dictate with Outloud": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Outloud diktieren"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig"
          }
        }
      }
    },
    "Each result keeps the transcript, the recording and the cleaned version. A shorter period also applies to results already kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu jedem Ergebnis gehören das Transkript, die Aufnahme und die bereinigte Fassung. Ein kürzerer Zeitraum gilt auch für bereits behaltene Ergebnisse."
          }
        }
      }
    },
    "Each way opens Outloud and starts recording at once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Weg öffnet Outloud und startet sofort die Aufnahme."
          }
        }
      }
    },
    "Easy to find and to explain to others.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leicht zu finden und anderen zu erklären."
          }
        }
      }
    },
    "Good": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorteile"
          }
        }
      }
    },
    "Hands-free.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Hände."
          }
        }
      }
    },
    "Hide": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausblenden"
          }
        }
      }
    },
    "History": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlauf"
          }
        }
      }
    },
    "Home Screen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home-Bildschirm"
          }
        }
      }
    },
    "In Settings › Action Button, choose Shortcut › Outloud › Dictate. Pressing the button then opens Outloud and starts recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in Einstellungen › Action-Taste › Kurzbefehl › Outloud › Diktieren. Ein Druck auf die Taste öffnet dann Outloud und startet die Aufnahme."
          }
        }
      }
    },
    "In the Shortcuts app, add Outloud's shortcut Dictate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge in der Kurzbefehle-App den Outloud-Kurzbefehl „Diktieren“ hinzu."
          }
        }
      }
    },
    "In use": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet"
          }
        }
      }
    },
    "Keep in mind": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachteile"
          }
        }
      }
    },
    "Lock Screen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperrbildschirm"
          }
        }
      }
    },
    "Music and podcasts pause while you dictate in Outloud and may play on afterwards. From the shortcut, iOS only lets Outloud turn music down and pause spoken audio.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Musik und Podcasts pausieren, während du in Outloud diktierst, und können danach weiterspielen. Über den Kurzbefehl erlaubt iOS Outloud nur, Musik leiser zu stellen und gesprochene Inhalte zu pausieren."
          }
        }
      }
    },
    "No button needed; works on every iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Knopf nötig; funktioniert auf jedem iPhone."
          }
        }
      }
    },
    "One press from anywhere, even with the iPhone locked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Druck von überall, auch bei gesperrtem iPhone."
          }
        }
      }
    },
    "One press, also on the Lock Screen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Druck, auch auf dem Sperrbildschirm"
          }
        }
      }
    },
    "Only from the Home Screen, with the iPhone unlocked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur vom Home-Bildschirm, bei entsperrtem iPhone."
          }
        }
      }
    },
    "Only on iPhones with an Action Button.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf iPhones mit Action-Taste."
          }
        }
      }
    },
    "Open Outloud once to download its models.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Outloud einmal, um die Modelle zu laden."
          }
        }
      }
    },
    "Open Settings › Accessibility › Touch › Back Tap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Einstellungen › Bedienungshilfen › Tippen › Auf Rückseite tippen."
          }
        }
      }
    },
    "Open Settings › Action Button.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Einstellungen › Action-Taste."
          }
        }
      }
    },
    "Open the Shortcuts app and find Outloud › Dictate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Kurzbefehle-App und suche Outloud › Diktieren."
          }
        }
      }
    },
    "Opens Outloud and starts recording. Tap Stop when you are done; the text is copied to the clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Outloud und startet die Aufnahme. Tippe auf Stopp, wenn du fertig bist; der Text wird in die Zwischenablage kopiert."
          }
        }
      }
    },
    "Or use the keyboard's dictation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder das Diktat der Tastatur verwenden"
          }
        }
      }
    },
    "Outloud": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Outloud"
          }
        }
      }
    },
    "Pause playback while dictating": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabe beim Diktieren pausieren"
          }
        }
      }
    },
    "Privacy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutz"
          }
        }
      }
    },
    "Ready before you unlock the iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit, bevor du das iPhone entsperrst."
          }
        }
      }
    },
    "Remove the flashlight or the camera control at the bottom.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entferne unten die Taschenlampe oder die Kamera."
          }
        }
      }
    },
    "Removes filler words, fixes punctuation and sets paragraphs, then copies the text to the clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Füllwörter, korrigiert die Zeichensetzung, setzt Absätze und kopiert den Text in die Zwischenablage."
          }
        }
      }
    },
    "Removes filler words, fixes punctuation and sets paragraphs, without changing what you said.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Füllwörter, korrigiert die Zeichensetzung und setzt Absätze, ohne zu ändern, was du gesagt hast."
          }
        }
      }
    },
    "Replaces what the button does now, e.g. silent mode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt die bisherige Funktion der Taste, z. B. den Stumm-Modus."
          }
        }
      }
    },
    "Say “Dictate with Outloud”": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag „Mit Outloud diktieren“"
          }
        }
      }
    },
    "Say “Hey Siri, dictate with Outloud”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag „Hey Siri, mit Outloud diktieren“."
          }
        }
      }
    },
    "Search for Outloud and choose Dictate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach Outloud und wähle „Diktieren“."
          }
        }
      }
    },
    "Set up": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einrichten"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen"
          }
        }
      }
    },
    "Siri": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri"
          }
        }
      }
    },
    "Swipe down from the top right corner.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische von oben rechts nach unten."
          }
        }
      }
    },
    "Swipe down, tap": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach unten wischen, tippen"
          }
        }
      }
    },
    "Swipe to Controls and tap Choose a Control.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische zu „Steuerelemente“ und tippe auf „Steuerelement auswählen“."
          }
        }
      }
    },
    "Takes the place of the flashlight or the camera.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt den Platz von Taschenlampe oder Kamera ein."
          }
        }
      }
    },
    "Tap the back of the iPhone twice": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweimal auf die Rückseite tippen"
          }
        }
      }
    },
    "Tap the plus and choose Outloud › Dictate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das Plus und wähle Outloud › Diktieren."
          }
        }
      }
    },
    "Tap to dictate. Paste the text in any app afterwards.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe zum Diktieren. Füge den Text danach in einer beliebigen App ein."
          }
        }
      }
    },
    "Tap to stop. The text is copied to the clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe zum Beenden. Der Text wird in die Zwischenablage kopiert."
          }
        }
      }
    },
    "Tap, speak, tap again.\nThe text lands on the clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen, sprechen, noch einmal tippen.\nDer Text landet in der Zwischenablage."
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Text"
          }
        }
      }
    },
    "Text to clean up": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu bereinigender Text"
          }
        }
      }
    },
    "The Action Button": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Action-Taste"
          }
        }
      }
    },
    "There was no text to clean up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gab keinen Text zum Bereinigen."
          }
        }
      }
    },
    "Touch and hold an empty space, then tap Add a Control.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege den Finger auf eine freie Stelle und tippe auf „Steuerelement hinzufügen“."
          }
        }
      }
    },
    "Touch and hold it, then choose Add to Home Screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege den Finger darauf und wähle „Zum Home-Bildschirm“."
          }
        }
      }
    },
    "Touch and hold the Lock Screen, then tap Customize › Lock Screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege den Finger auf den Sperrbildschirm und tippe auf Anpassen › Sperrbildschirm."
          }
        }
      }
    },
    "Transcription model": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptionsmodell"
          }
        }
      }
    },
    "Transcripts, recordings and cleaned versions are deleted from this iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripte, Aufnahmen und bereinigte Fassungen werden von diesem iPhone gelöscht."
          }
        }
      }
    },
    "Two steps: swipe down, then tap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Schritte: nach unten wischen, dann tippen."
          }
        }
      }
    },
    "Type or dictate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen oder diktieren"
          }
        }
      }
    },
    "Type text instead": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stattdessen Text eingeben"
          }
        }
      }
    },
    "Works on every iPhone, in every app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert auf jedem iPhone, in jeder App."
          }
        }
      }
    },
    "You speak out loud before dictating; Siri must be on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du sprichst vor dem Diktat laut; Siri muss eingeschaltet sein."
          }
        }
      }
    },
    "The microphone is open only while you record.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon ist nur offen, während du aufnimmst."
          }
        }
      }
    },
    "Cleaning up text needs Apple Intelligence, switched on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Bereinigen von Text muss Apple Intelligence eingeschaltet sein."
          }
        }
      }
    },
    "Removes filler words, fixes punctuation and sets paragraphs, and returns the text, e.g. for Copy to Clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Füllwörter, korrigiert die Zeichensetzung, setzt Absätze und gibt den Text zurück, z. B. für „In Zwischenablage kopieren“."
          }
        }
      }
    },
    "Cleanup is switched off in Outloud's settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bereinigung ist in den Einstellungen von Outloud ausgeschaltet."
          }
        }
      }
    },
    "Outloud could not clean up this text. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Outloud konnte diesen Text nicht bereinigen. Bitte versuche es noch einmal."
          }
        }
      }
    },
    "Outloud is busy with another dictation. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Outloud ist gerade mit einem anderen Diktat beschäftigt. Bitte versuche es noch einmal."
          }
        }
      }
    },
    "Start or Stop Dictation with Outloud": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktat mit Outloud starten oder beenden"
          }
        }
      }
    },
    "Starts recording without opening Outloud, or ends the recording and returns the cleaned text, e.g. for Copy to Clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet die Aufnahme, ohne Outloud zu öffnen, oder beendet sie und gibt den bereinigten Text zurück, z. B. für „In Zwischenablage kopieren“."
          }
        }
      }
    },
    "Stop Dictation": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktat beenden"
          }
        }
      }
    },
    "1. Set up the shortcut, once": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Kurzbefehl einmal einrichten"
          }
        }
      }
    },
    "2. Choose how to run it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Auswählen, wie du ihn startest"
          }
        }
      }
    },
    "A button you can feel, in any app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Taste, die du fühlst, in jeder App."
          }
        }
      }
    },
    "A small button on the screen, one tap": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleiner Knopf auf dem Bildschirm, ein Tipp"
          }
        }
      }
    },
    "Add the action Start or Stop Dictation with Outloud.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Aktion „Diktat mit Outloud starten oder beenden“ hinzu."
          }
        }
      }
    },
    "AssistiveTouch": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AssistiveTouch"
          }
        }
      }
    },
    "Below it, add Copy to Clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge darunter „In Zwischenablage kopieren“ hinzu."
          }
        }
      }
    },
    "Can start by accident, e.g. when you put the iPhone down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann versehentlich auslösen, z. B. beim Ablegen des iPhone."
          }
        }
      }
    },
    "Choose Double Tap or Triple Tap and pick your shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Doppeltippen“ oder „Dreimal tippen“ und deinen Kurzbefehl."
          }
        }
      }
    },
    "Choose Shortcuts › Run Shortcut, then your shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle „Kurzbefehle“ › „Kurzbefehl ausführen“ und dann deinen Kurzbefehl."
          }
        }
      }
    },
    "Dictate from Any App": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus jeder App diktieren"
          }
        }
      }
    },
    "Dictate from any app": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus jeder App diktieren"
          }
        }
      }
    },
    "Hidden with a triple-click when you do not need it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Per Dreifachklick ausgeblendet, wenn du ihn nicht brauchst."
          }
        }
      }
    },
    "In the Shortcuts app, tap + to create a shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in der Kurzbefehle-App auf +, um einen Kurzbefehl zu erstellen."
          }
        }
      }
    },
    "Name the shortcut, e.g. Dictate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib dem Kurzbefehl einen Namen, z. B. „Diktat“."
          }
        }
      }
    },
    "Needs no shortcut, but Outloud comes to the front.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht keinen Kurzbefehl, aber Outloud kommt in den Vordergrund."
          }
        }
      }
    },
    "No button needed, on every iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Taste nötig, auf jedem iPhone."
          }
        }
      }
    },
    "Not always recognised, above all through a thick case.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nicht immer erkannt, vor allem durch eine dicke Hülle."
          }
        }
      }
    },
    "On every iPhone, in every app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf jedem iPhone, in jeder App."
          }
        }
      }
    },
    "One press, also with the iPhone locked": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Druck, auch bei gesperrtem iPhone"
          }
        }
      }
    },
    "One tap, recognised every time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tipp, der jedes Mal erkannt wird."
          }
        }
      }
    },
    "Open Settings › Accessibility › Touch › AssistiveTouch and switch it on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Einstellungen › Bedienungshilfen › Tippen › AssistiveTouch und schalte es ein."
          }
        }
      }
    },
    "Open Settings › Action Button, swipe to Controls and choose Outloud › Dictate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Einstellungen › Action-Taste, wische zu „Steuerelemente“ und wähle Outloud › Diktieren."
          }
        }
      }
    },
    "Opens Outloud and starts recording": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Outloud und startet die Aufnahme"
          }
        }
      }
    },
    "Optional: under Settings › Accessibility › Accessibility Shortcut, choose AssistiveTouch. A triple-click on the side button then shows or hides the button.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: Wähle unter Einstellungen › Bedienungshilfen › Kurzbefehl für Bedienungshilfen „AssistiveTouch“. Ein Dreifachklick auf die Seitentaste blendet den Knopf dann ein oder aus."
          }
        }
      }
    },
    "Or add Outloud › Dictate to the Control Center or the Lock Screen: touch and hold an empty space, then tap Add a Control.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder füge Outloud › Diktieren dem Kontrollzentrum oder dem Sperrbildschirm hinzu: Halte eine freie Stelle gedrückt und tippe auf „Steuerelement hinzufügen“."
          }
        }
      }
    },
    "Or open Outloud and record": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder Outloud öffnen und aufnehmen"
          }
        }
      }
    },
    "Outloud comes to the front; you switch back to paste.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Outloud kommt in den Vordergrund; zum Einfügen wechselst du zurück."
          }
        }
      }
    },
    "Outloud's Dictate control": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuerelement „Diktieren“ von Outloud"
          }
        }
      }
    },
    "Replaces what the button does now, e.g. the flashlight.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt, was die Taste jetzt tut, z. B. die Taschenlampe."
          }
        }
      }
    },
    "Run it once to start recording and again to stop. Outloud stays in the background, the Dynamic Island shows what is happening, and the text lands on the clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal ausführen startet die Aufnahme, noch einmal beendet sie. Outloud bleibt im Hintergrund, die Dynamic Island zeigt, was gerade passiert, und der Text landet in der Zwischenablage."
          }
        }
      }
    },
    "Say the shortcut's name": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag den Namen des Kurzbefehls"
          }
        }
      }
    },
    "Say “Hey Siri” and the name of your shortcut, e.g. “Dictate”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag „Hey Siri“ und den Namen deines Kurzbefehls, z. B. „Diktat“."
          }
        }
      }
    },
    "Set Idle Opacity to about 15 %, so that the button stays out of the way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell die Deckkraft im Ruhezustand auf etwa 15 %, damit der Knopf nicht stört."
          }
        }
      }
    },
    "Set up a shortcut once, then start and stop without leaving your app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte einmal einen Kurzbefehl ein, dann startest und beendest du, ohne deine App zu verlassen."
          }
        }
      }
    },
    "Swipe to Shortcut and choose your shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische zu „Kurzbefehl“ und wähle deinen Kurzbefehl."
          }
        }
      }
    },
    "Tap the back of the iPhone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf die Rückseite des iPhone tippen"
          }
        }
      }
    },
    "Under Custom Actions, set Single-Tap to your shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg unter „Eigene Aktionen“ bei „Einmal tippen“ deinen Kurzbefehl fest."
          }
        }
      }
    },
    "While it is on, a small button lies on the screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange es an ist, liegt ein kleiner Knopf auf dem Bildschirm."
          }
        }
      }
    },
    "Works without setting up a shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert ohne eingerichteten Kurzbefehl."
          }
        }
      }
    }
  },
  "version": "1.0"
}
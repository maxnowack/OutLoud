      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In die Zwischenablage kopiert"
          }
        }
      }
    },
    "Copied to the clipboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In die Zwischenablage kopiert."
          }

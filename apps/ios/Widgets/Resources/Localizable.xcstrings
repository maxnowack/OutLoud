    "Opens Outloud and starts recording. Tap Stop when you are done; the text is copied to the clipboard." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Öffnet Outloud und startet die Aufnahme. Tippe auf Stopp, wenn du fertig bist; der Text wird in die Zwischenablage kopiert." } } } },
    "Cleaning up…" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Wird bereinigt…" } } } },

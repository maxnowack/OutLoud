    "Dictation failed" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Diktat fehlgeschlagen" } } } },
    "Not copied: run the shortcut again to end a dictation." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht kopiert: Beende ein Diktat, indem du den Kurzbefehl erneut startest." } } } },

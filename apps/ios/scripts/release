#!/bin/sh
# Builds the iOS app for TestFlight: archive, App Store distribution signature, upload to App
# Store Connect (docs/RELEASE.md §"iOS", ADR 0023).
#
# Signs and uploads with automatic signing of team 95ZC649QPM: with an App Store Connect API key
# when ASC_KEY_ID and ASC_ISSUER_ID are set — which works without an account signed in to Xcode —,
# otherwise with the account signed in to Xcode; the key is found
# by ../shared/scripts/asc-key.sh. Raise CURRENT_PROJECT_VERSION in project.yml before each
# upload: App Store Connect takes every build number of a version only once.
#
# Usage: ./scripts/release            archive and upload
#        ./scripts/release --export   archive and export the .ipa locally, without uploading
set -eu
cd "$(dirname "$0")/.."
destination=upload
if [ "${1:-}" = "--export" ]; then destination=export; fi
version=$(sed -n 's/^ *MARKETING_VERSION: *"\(.*\)"/\1/p' project.yml)
build=$(sed -n 's/^ *CURRENT_PROJECT_VERSION: *"\(.*\)"/\1/p' project.yml)
. ../shared/scripts/asc-key.sh
set --
if [ -n "$key" ]; then
    set -- -authenticationKeyID "$ASC_KEY_ID" -authenticationKeyIssuerID "$ASC_ISSUER_ID" \
        -authenticationKeyPath "$key"
fi
out=.build/release
rm -rf "$out"
mkdir -p "$out"
xcodegen generate --quiet
xcodebuild -project Outloud.xcodeproj -scheme Outloud -configuration Release \
    -destination 'generic/platform=iOS' -derivedDataPath .build/DerivedData -jobs 4 -quiet \
    -allowProvisioningUpdates "$@" -archivePath "$out/Outloud.xcarchive" \
    archive
cat > "$out/ExportOptions.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>method</key><string>app-store-connect</string>
  <key>destination</key><string>$destination</string>
  <key>teamID</key><string>95ZC649QPM</string>
  <key>signingStyle</key><string>automatic</string>
  <key>signingCertificate</key><string>Apple Distribution</string>
  <key>manageAppVersionAndBuildNumber</key><false/>
</dict>
</plist>
PLIST
xcodebuild -exportArchive -archivePath "$out/Outloud.xcarchive" \
    -exportOptionsPlist "$out/ExportOptions.plist" -exportPath "$out/export" \
    -allowProvisioningUpdates "$@" -quiet
if [ "$destination" = upload ]; then
    echo "Uploaded $version ($build). App Store Connect processes it; then it appears in TestFlight."
else
    echo "Exported $version ($build) to $out/export."
fi
